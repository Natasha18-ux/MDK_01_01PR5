<UserControl x:Class="Constructors_Патрушева.Student"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Constructors_Патрушева"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="50" Margin="0, 0, 0, 10" Background="#35363A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="50" Height="50" Name="Click" Cursor="Hand" MouseLeftButtonUp="Get_image">
            <Grid>
                <Image Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,0"
                       Stretch="UniformToFill" Source="/Images/ic_user.png"  Name="Delet_after"/>
                <Image x:Name="Here_image"/>
            </Grid>
        </Border>
        <Label Name="tb_info" Content="Фамилия Имя Отчество" VerticalAlignment="Center"
               Margin="9.4, 10, 10.2, 10" Grid.Column="1" Foreground="White" FontSize="14"/>
        <Label Name="tb_scholarship" Content="Степендия: получает" VerticalAlignment="Center"
               Margin="9.8, 10" Grid.Column="2" Foreground="White" FontSize="14"/>
        <Label Name="tb_course" Content="Курс: 4" VerticalAlignment="Center"
               Margin="9.2, 10, 9.6, 10" Grid.Column="3" Foreground="White" FontSize="14"/>

        <Grid.Effect>
            <DropShadowEffect Color="Black" Direction="315" Opacity="0.7" RenderingBias="Performance" BlurRadius="5"/>
        </Grid.Effect>

    </Grid>
</UserControl>
