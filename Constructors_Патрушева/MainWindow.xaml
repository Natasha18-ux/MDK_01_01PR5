<Window x:Class="Constructors_Патрушева.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Constructors_Патрушева"
        mc:Ignorable="d"
        Title="Студенты КГАПОУ Авиатехникума" Height="450" Width="800" MinHeight="450" MinWidth="800" FontFamily="Arial Narrow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="For_serch" Grid.Row="0" Margin="10,10,150,5" Height="30"/>
        <Button Background="Black" Margin="665,10,10,5" Content="ПОИСК" Foreground="White" Click="Serch_click"/>
        <ScrollViewer ScrollChanged="ScrollViewer_ScrollChanged" Grid.Row="1">
            <StackPanel Margin="10" Name="parent"></StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
